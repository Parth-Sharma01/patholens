# ─────────────────────────────────────────────────────────────────────────────
# PathoLens – Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Engine (pick one – both are free) ─────────────────────────────────────
# Google Gemini 1.5 Flash — get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (Llama 3.1-8B Instant) — get your key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Google Form / Sheet Data ──────────────────────────────────────────────────
# Publish the Form-response Sheet as CSV and paste the URL here:
# Sheets → File → Share → Publish to web → CSV → Copy link
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv
GOOGLE_SHEET_CSV_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Cache duration for Google Sheets data in seconds (default: 300 = 5 minutes)
SHEET_CACHE_SECONDS=300
